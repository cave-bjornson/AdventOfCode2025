<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico"/>
        <None Remove="Icon.bmp"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
            <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
            <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AoCHelper.Net" Version="2.0.0" />
        <PackageReference Include="Gum.MonoGame" Version="2025.11.30.1" />
        <PackageReference Include="MLEM.Extended" Version="8.0.0" />
        <PackageReference Include="MonoGame.Aseprite" Version="6.3.1" />
        <PackageReference Include="MonoGame.Extended" Version="5.3.1"/>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5-develop.13"/>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Components\" />
      <Folder Include="Content\" />
      <Folder Include="Settings\" />
    </ItemGroup>
    <Target Name="BuildContent" BeforeTargets="Build">
        <PropertyGroup>
            <ContentOutput>$(ProjectDir)$(OutputPath)</ContentOutput>
            <ContentTemp>$(ProjectDir)$(IntermediateOutputPath)</ContentTemp>
            <ContentArgs>build -p $(MonoGamePlatform) -s Assets -o $(ContentOutput) -i $(ContentTemp)</ContentArgs>
        </PropertyGroup>
        <MSBuild Projects="..\Content\Content.csproj" Targets="Build;Run"
                 Properties="RunArguments=$(ContentArgs);"/>
    </Target>

</Project>